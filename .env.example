# Optional configuration for `docker compose up`.
# Copy to `.env` (Docker Compose loads it automatically). Everything here is
# optional — model credentials can also be configured in the Web UI per
# provider, which is the recommended path.

# Gaode/AMap MCP — enables the `amap` map tool in the backend.
AMAP_API_KEY=

# Model provider keys (injected into the backend container's environment).
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Host port for the Web UI (frontend). Change if 8080 is already in use.
# WEBUI_PORT=8080

# Where the browser reaches the backend. Baked into the frontend bundle at
# build time; the default works for a single-host local deployment. Change it
# (and rebuild the frontend) if the backend is exposed elsewhere.
# VITE_SERVER_URL=http://localhost:8000
