# Optional configuration for `docker compose up`.
# Copy to `.env` (Docker Compose loads it automatically). Everything here is
# optional — model credentials can also be configured in the Web UI per
# provider, which is the recommended path.

# Gaode/AMap MCP — enables the `amap` map tool in the backend.
AMAP_API_KEY=

# Model provider keys (injected into the backend container's environment).
DASHSCOPE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Host port for the Web UI (frontend). Change if 8080 is already in use.
# WEBUI_PORT=8080

# Host port for direct backend access (default 8000). The Web UI doesn't need
# it — it reaches the backend via the frontend's /api reverse proxy. Set only
# if 8000 is taken on the host; the container always listens on 8000 internally.
# BACKEND_PORT=8000

# Optional explicit backend URL baked into the frontend bundle. Empty by
# default, so the frontend calls the backend same-origin via /api (works on any
# host/IP, no CORS). Set only to point at a remote/standalone backend, then
# rebuild the frontend.
# VITE_SERVER_URL=https://backend.example.com
